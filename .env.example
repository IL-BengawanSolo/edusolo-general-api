# EduSolo General API — Environment template
# Usage:
# - Local dev:  cp .env.example .env.development.local  → edit real localhost values (gitignored)
# - Production (Vercel): set same keys in Vercel Dashboard → Settings → Environment Variables (Production), do NOT commit .env.production.local
# Only 2 files: .env.example (committed) + .env.development.local (ignored). No need for 5 files.

# App
PORT=5500
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://edusolo-fe.vercel.app
BASE_URL=http://localhost:5500

# Database
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=edusolo
MYSQL_POOL_LIMIT=10

# Auth - generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET=change-me-to-random-32+chars
JWT_EXPIRES_IN=1d

# AI
GROQ_API_KEY=gsk_your_groq_key_here
